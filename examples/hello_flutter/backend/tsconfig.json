{
  "compilerOptions": {
    "rootDir": "./src",
    "lib": ["ES2020"],
    "target": "ES2020",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowUnreachableCode": false,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["bun-types"]
  },
  "include": ["src/**/*"]
}
