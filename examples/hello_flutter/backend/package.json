{
  "name": "hello-flutter-backend",
  "version": "1.0.0",
  "description": "SkirRPC backend for hello_flutter example",
  "scripts": {
    "codegen": "skir gen",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "dev": "bun run src/server.ts",
    "start": "bun run src/server.ts"
  },
  "dependencies": {
    "skir-client": "^1.0.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "bun-types": "^1.3.14",
    "eslint": "^9.27.0",
    "prettier": "^3.2.4",
    "skir": "^1.2.18",
    "skir-typescript-gen": "^1.0.11",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.33.0"
  }
}
