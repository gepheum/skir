{
  "name": "skir-monorepo",
  "private": true,
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=skir-internal && npm run build --workspace=skir-client && npm run build --workspace=skir && npm run build --workspace=skir-codemirror-plugin && npm run build --workspace=skir-studio && npm run build --workspace=skir-converter && npm run build --workspace=skir-language-server && npm run compile --workspace=skir-language",
    "website:dev": "npm run dev --workspace=@skir/website",
    "website:build": "npm run build --workspace=@skir/website",
    "skir": "node packages/compiler/dist/compiler.js",
    "test": "node --import tsx ./node_modules/mocha/bin/mocha.js \"packages/compiler-internal/src/**/*.test.ts\" \"packages/compiler/src/**/*.test.ts\" \"packages/typescript-client/tests/**/*.test.ts\" \"packages/codemirror-plugin/src/**/*.test.ts\" \"packages/studio/src/**/*.test.ts\"",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "buckwheat": "^1.1.3",
    "eslint": "^10.0.1",
    "mocha": "^11.7.5",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.57.2"
  },
  "overrides": {
    "diff": "^8.0.3",
    "minimatch": "^10.2.2",
    "serialize-javascript": "^7.0.4"
  }
}
