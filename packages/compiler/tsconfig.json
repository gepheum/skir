{
  "compilerOptions": {
    "rootDir": "./src",
    "lib": ["ES2020"],
    "target": "ES2020",
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": ["src/**/*"]
}
